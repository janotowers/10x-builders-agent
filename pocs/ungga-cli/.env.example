# URL inicial para iniciar sesión en Ungga.
# En este POC usamos la pantalla real de login. Si Ungga cambia su login,
# probablemente habrá que ajustar selectores en src/steps.mjs.
UNGGA_STAGING_URL=https://ungga.com/login

# Credenciales de la cuenta de prueba usada por el POC.
# OJO: esto es temporal/local para aprendizaje. En producción no debería vivir
# en .env local, sino en Supabase asociado a la cuenta/usuario correspondiente.
UNGGA_STAGING_EMAIL=
UNGGA_STAGING_PASSWORD=

# Título usado por scripts legacy de prueba como poc:create.
# Para poc:publish normalmente manda más el JSON de fixtures/listing.sample.json.
UNGGA_TEST_PROPERTY_TITLE=POC test - DELETE ME

# Indica si scripts legacy deben intentar limpiar propiedades de prueba.
# Actualmente el flujo principal de publish guarda borradores; no conviene asumir
# borrado automático hasta tener selectores seguros de eliminación.
UNGGA_TEST_CLEANUP=true

# Número de iteraciones para scripts/reportes legacy del POC.
# No es crítico para poc:publish.
N=10

# true = sólo llena el wizard y captura evidencia, pero NO guarda.
# false = llena el wizard y presiona "Guardar como borrador".
# Incluso en false, el POC NO presiona "Publicar".
UNGGA_CLI_DRY_RUN=true

# Habilita el fallback CLI desde el adapter `ungga_publish_listing`.
# En desarrollo local el adapter también puede detectar este .env del POC, pero
# en producción debe activarse explícitamente con esta variable.
# UNGGA_CLI_ENABLED=true

# false = abre Chromium visible para observar qué hace Playwright.
# true = corre en segundo plano sin ventana visible; útil para operación automatizada.
UNGGA_CLI_HEADLESS=true

# true = guarda screenshots en artifacts para auditoría/debug.
# Muy útil para verificar qué hizo el agente y diagnosticar cambios de UI.
UNGGA_CLI_SCREENSHOTS=true

# Timeout total del proceso CLI (parent kill). Preferido sobre UNGGA_CLI_TIMEOUT_MS.
# UNGGA_CLI_TOTAL_TIMEOUT_MS=300000

# Timeout general legacy (compat). Si TOTAL TOTAL, se usa como fallback del total.
UNGGA_CLI_TIMEOUT_MS=60000

# Timeouts cortos por operación (no deben heredar el total de 5 minutos).
# UNGGA_CLI_NAV_TIMEOUT_MS=45000
# UNGGA_CLI_ACTION_TIMEOUT_MS=15000
# UNGGA_CLI_UPLOAD_TIMEOUT_MS=90000

# Ruta donde empieza el flujo de propiedades.
# Puede ser el listado (/app/propiedades) o directo al wizard (/app/propiedades/nueva).
# Si entra al listado, el script busca "Nueva propiedad" y navega al wizard.
UNGGA_CLI_PUBLISH_PATH=https://ungga.com/app/propiedades

# Sólo para npm run poc:inspect. Si se define, el inspector llena GENERAL con
# este fixture y avanza el wizard para mapear DETALLES / MEDIA / OPERACIÓN.
# UNGGA_CLI_INSPECT_FIXTURE=fixtures/listing.sample.json
