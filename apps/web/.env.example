# Supabase (JS client — REST API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL for LangGraph checkpointing (optional locally).
# Supabase → Project Settings → Database → Connection string (URI). Separate from the keys above.
# If unset, the agent uses in-memory checkpoints only.
DATABASE_URL=

# Optional: DNS resolution order for the checkpointer connection. Default
# is `ipv4first`, which avoids ETIMEDOUT on local networks that don't route
# IPv6 to AWS. Allowed values: ipv4first | verbatim | ipv6first | off.
# CHECKPOINTER_DNS_ORDER=ipv4first

# Optional: absolute path to the monorepo root for the skills loader.
# Only needed when the auto-detector cannot find `<repo>/skills/global/`
# (typical with bundlers that rewrite import.meta.url). The agent logs
# `[skills] registry loaded root=…` on first turn — set this if the path
# is wrong.
# SKILLS_ROOT_DIR=C:\path\to\10x-builders-agent

# Site URL (no trailing slash). Used for OAuth redirect_uri and public booking links.
# Local: http://localhost:3000  |  Production / ngrok: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter (LLM routing)
OPENROUTER_API_KEY=your-openrouter-key
# Límite de tokens de salida por llamada. OpenRouter RESERVA ese valor contra
# tu saldo antes de ejecutar la llamada (aunque la respuesta real sea menor),
# así que bájalo si tienes poco crédito para evitar 402. Default del código: 2048.
# OPENROUTER_MAX_TOKENS=2048

# ── AI usage metering (Slice 0.4 / Flexible Workflows) ─────────────────────
# Ledger append-only en `ai_usage_events` (migración 00064). Observabilidad
# interna de tokens/costo por llamada — NO es billing ni UI de broker.
# Off por defecto: sin esto, el meter no escribe filas (selftests inyectan
# un recorder y no necesitan el flag).
# Requisitos: migración 00064 aplicada + service-role DB client en el server.
# Dashboard interno (solo is_ungga_admin): /settings/ai-usage
# En la UI: Configuración → Uso de IA (visible solo para admins Ungga).
# Rollback: pon false o comenta la línea; las filas ya escritas quedan inertes.
# AI_USAGE_METERING_ENABLED=true

# ── Modelos LLM por tarea (OpenRouter slugs; todos opcionales) ─────────────
# Slugs válidos: https://openrouter.ai/models

# Agente principal (runAgent): web, telegram, cron, case_runner.
# Default en model.ts: openai/gpt-5.4-mini
# MAIN_AGENT_MODEL_ID=openai/gpt-5.4-mini

# Compaction / memory flush (resumen mecánico del historial).
# Default en model.ts: anthropic/claude-haiku-4.5
# COMPACTION_MODEL_ID=anthropic/claude-haiku-4.5

# Skill selector (pre-graph, JSON estricto).
# Default en model.ts: anthropic/claude-haiku-4.5
# SKILL_SELECTOR_MODEL_ID=anthropic/claude-haiku-4.5

# Business Brain reviewer (Settings).
# Default en model.ts: anthropic/claude-haiku-4.5
# BUSINESS_BRAIN_REVIEWER_MODEL_ID=anthropic/claude-haiku-4.5

# Vision model for image/photo analysis tools (OpenRouter slug).
# Used by analyze_property_images (and reusable for future image tools).
# Default in code: openai/gpt-4.1-mini
# IMAGE_VISION_MODEL_ID=openai/gpt-4.1-mini
# IMAGE_VISION_MAX_TOKENS=1500
# IMAGE_VISION_TEMPERATURE=0

# Listing copy draft model (OpenRouter slug).
# Used by prepare_listing_description_draft.
# Default in code: openai/gpt-4.1-mini
# LISTING_COPY_MODEL_ID=openai/gpt-4.1-mini
# LISTING_COPY_MAX_TOKENS=1200
# LISTING_COPY_TEMPERATURE=0.1

# Heartbeat (cron proactivo). Si omites, hereda MAIN_AGENT_MODEL_ID.
# Conviene un modelo barato (p. ej. gpt-*-nano) porque corre cada X minutos.
# HEARTBEAT_MODEL_ID=openai/gpt-4o-mini
# HEARTBEAT_MAX_TOKENS=1024

# Clasificador conversacional de casos (intake/routing) + 2ª opinión HITL en
# pending-decision `unclear` (Fase 3.3). JSON estricto; sin OPENROUTER_API_KEY
# el HITL hace fail-open a «acláralo» y el intake cae a reglas deterministas.
# Default en model.ts: openai/gpt-5.4-mini
# OPERATIONAL_CONVERSATION_CLASSIFIER_MODEL_ID=openai/gpt-5.4-mini

# Extractor de características del dueño (respuesta libre a characteristics_pending).
# Default: openai/gpt-4o-mini
# OWNER_CHARACTERISTICS_EXTRACTOR_MODEL_ID=openai/gpt-4o-mini

# Extractor de datos contractuales (contract_data_review HITL, texto libre).
# Default: openai/gpt-4o-mini. Sin OPENROUTER_API_KEY usa fallback determinístico.
# CONTRACT_COMMERCIAL_EXTRACTOR_MODEL_ID=openai/gpt-4o-mini

# ── Model policy por rol de worker (§9.1 / Slice 3.4) ───────────────────────
# Cadena de resolución: model_policy del worker profile (alias lógico) →
# env del rol (estas variables) → MAIN_AGENT_MODEL_ID (solo modos agénticos).
# Los aliases (reasoning_standard/reasoning_high/fast_cheap) se mapean en
# packages/agent/src/model.ts (WORKER_MODEL_ALIAS_MAP); promover un modelo
# más fuerte requiere evidencia (falso-accept/reject del verifier), no gusto.
# Verificador de valuación/comparables. Default: openai/gpt-5.4-mini
# WORKFLOW_VERIFIER_MODEL_ID=openai/gpt-5.4-mini
# Descomponedor de intents multi-parte (Phase 4). Default: openai/gpt-5.4-mini
# WORKFLOW_INTENT_DECOMPOSER_MODEL_ID=openai/gpt-5.4-mini
# Compilador NL → spec (Phase 4). Default: openai/gpt-5.4-mini
# WORKFLOW_COMPILER_MODEL_ID=openai/gpt-5.4-mini

# AES-256-GCM key for encrypting integration tokens at rest (GitHub, Google Calendar, etc.)
# Must be exactly 64 hex characters (32 bytes). Example: openssl rand -hex 32
ENCRYPTION_KEY=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth by user (optional: Calendar, Gmail, and future Google OAuth integrations).
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Google BigQuery (optional — skill global `company-data` / tool `bigquery_run_query`)
#
# If unset, the tool returns status="not_configured" and the model should not invent data.
# These variables are read by the Next.js API routes (same process as `runAgent`).
#
# Default project + location for jobs.query (REST). Also used to fill the
# [Contexto de tenant] block when Supabase `profiles.business_brain.bigquery`
# does not override `project_id` / `location`.
# BIGQUERY_PROJECT_ID=ungga-full
# BIGQUERY_LOCATION=US
#
# Auth — use ONE of the following (not both required):
#
# (A) Absolute path to the service-account JSON file (recommended for local dev).
#     Windows:  GOOGLE_APPLICATION_CREDENTIALS=C:\keys\bigquery-readonly.json
#     Unix:     GOOGLE_APPLICATION_CREDENTIALS=/home/you/keys/bigquery-readonly.json
#
# (B) Entire JSON as a single line (common on Vercel). Escape embedded " as \"
#     or minify the file to one line in a secrets manager.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
#
# The service account needs BigQuery read access to the project/datasets you query
# (e.g. roles/bigquery.dataViewer + bigquery.jobUser on the project, or tighter IAM).
# -----------------------------------------------------------------------------

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Public base URL for setWebhook (HTTPS, e.g. https://xxxx.ngrok-free.app). Optional if the proxy sends x-forwarded-host.
TELEGRAM_WEBHOOK_BASE_URL=

# Bash tool (optional — ejecuta comandos en el host del servidor; desactivado por defecto)
# BASH_TOOL_ENABLED=true
# Directorio de trabajo absoluto para comandos (opcional; por defecto process.cwd())
# BASH_TOOL_CWD=/ruta/absoluta

# File tools (read_file/write_file/edit_file) — desactivadas por defecto.
# Requiere ambas: habilitar y definir un directorio raíz absoluto que acota qué rutas puede tocar el agente.
# Todas las rutas que pase el modelo son RELATIVAS a FILE_TOOLS_ROOT (cualquier intento de escapar se rechaza).
# FILE_TOOLS_ENABLED=true
# FILE_TOOLS_ROOT=/ruta/absoluta/al/workspace

# Scheduled tasks cron endpoint (schedule_task tool)
# Secret token for POST /api/cron/scheduled-tasks. Must match the Authorization: Bearer header
# sent by Supabase Cron (pg_cron + pg_net). Generate with: openssl rand -hex 32
# CRON_SECRET=your-random-secret
# Optional concurrency cap for due tasks processed per cron tick (default 5, min 1, max 20).
# SCHEDULED_TASKS_CONCURRENCY=5

# Operational cases (Alebrixe pilot)
# Reuses CRON_SECRET for POST /api/cron/operational-cases.
# OPERATIONAL_CASES_CONCURRENCY=5
#
# Real estate integrations used by property-optioning operational cases.
# EASYBROKER_API_KEY=
# UNGGA_INTERNAL_API_BASE=https://app.ungga.com
# UNGGA_INTERNAL_API_TOKEN=
# Playwright CLI fallback for prepare_draft / publish_draft (pocs/ungga-cli).
# Prefer account-scoped Ungga automation credentials in Settings; these envs are
# for local lab / parent process budgets when the adapter spawns the CLI.
# Total parent kill budget (preferred). Legacy UNGGA_CLI_TIMEOUT_MS remains a fallback.
# UNGGA_CLI_TOTAL_TIMEOUT_MS=300000
# UNGGA_CLI_TIMEOUT_MS=300000
# Short per-operation Playwright budgets (do not inherit the 5-minute total):
# UNGGA_CLI_NAV_TIMEOUT_MS=45000
# UNGGA_CLI_ACTION_TIMEOUT_MS=15000
# UNGGA_CLI_UPLOAD_TIMEOUT_MS=90000
# Wizard entry URL for prepare_draft. Prefer /app/propiedades/nueva (not the
# catalog /app/propiedades). If omitted, the CLI defaults to /nueva and falls
# back there when the catalog path does not open the form.
# UNGGA_CLI_PUBLISH_PATH=https://ungga.com/app/propiedades/nueva
# Optional: UNGGA_CLI_HEADLESS=true | UNGGA_CLI_ENABLED=true
# Credenciales locales del POC viven en pocs/ungga-cli/.env (no en este archivo).

# Avaclick — opinión digital de valor (casa / depto en condominio).
# Fallback global cuando no hay credencial por cuenta en Ajustes → Avaclick.
# AVACLICK_API_URL=https://avaclick.app/Apiv2/Avaluo
# AVACLICK_COMPANY_NAME=
# AVACLICK_EMAIL=
# AVACLICK_PASSWORD=
# Catálogos JSON (Estado, Municipio, Colonia, etc.). Default: repo/pocs/avaclick/
# AVACLICK_CATALOGS_DIR=

# Geocoding provider (Google Maps Geocoding API)
# Usado para resolver latitude/longitude de direcciones cuando el usuario no comparte coordenadas.
# GOOGLE_MAPS_API_KEY=

# Optional: comma-separated origins for Next dev (see next.config.ts)
# NEXT_ALLOWED_DEV_ORIGINS=http://localhost:3000
